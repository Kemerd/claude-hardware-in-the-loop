# Text files are stored with LF and checked out per platform, except the files whose tools need a fixed ending.
* text=auto

# Scripts: bash needs LF even on Windows (Git Bash chokes on CR); PowerShell is happy with either, keep CRLF for Notepad users
*.sh      text eol=lf
*.py      text eol=lf
*.ps1     text eol=crlf
*.psm1    text eol=crlf

# KiCad files are generated by the pipeline with LF; keep them byte-stable so two runs give one file
*.kicad_sch  text eol=lf
*.kicad_pcb  text eol=lf
*.kicad_pro  text eol=lf
*.kicad_sym  text eol=lf
*.kicad_mod  text eol=lf
*-lib-table  text eol=lf

# Fab outputs: byte-exact (their SHA-256 is recorded in the board's results JSON)
*.gbr     binary
*.gbrjob  binary
*.drl     binary
*.gtl     binary
*.gbl     binary
*.gts     binary
*.gbs     binary
*.gto     binary
*.gbo     binary
*.gtp     binary
*.gbp     binary
*.gm1     binary
*.g1      binary
*.g2      binary
*.g3      binary
*.g4      binary
*.zip     binary

# Geometry and media
*.step    binary
*.stp     binary
*.stl     binary
*.glb     binary
*.png     binary
*.jpg     binary
*.pdf     binary
